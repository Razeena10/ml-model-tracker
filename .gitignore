# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Python caches ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- MLflow run data (regenerated on every run) ----
mlruns/
mlartifacts/
mlflow.db
# SQLite sidecar files created alongside mlflow.db (WAL/SHM/journal)
mlflow.db-wal
mlflow.db-shm
mlflow.db-journal

# ---- Logs (generated by mlflow ui / training / server runs) ----
*.log

# ---- Generated model artifacts (regenerated by training) ----
artifacts/*
!artifacts/.gitkeep

# ---- Secrets / local config ----
.env
*.key

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Local workspace metadata (IDE/tooling-generated, not source) ----
project-id
